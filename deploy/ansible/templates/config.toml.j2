secret = "{{ mtg_secret }}"
bind-to = "0.0.0.0:{{ mtg_proxy_port }}"

users-file = "{{ mtg_install_dir }}/users.toml"

public-ipv4 = "{{ mtg_public_ip }}"

# Dial Telegram DCs over IPv4. Default prefer-ipv6 breaks large media on many VPS.
prefer-ip = "prefer-ipv4"

# FakeTLS timestamp window (client clock skew).
tolerate-time-skewness = "30s"

[network.timeout]
idle = "30m"

[network]
tcp-not-sent-lowat = "2mib"

[api]
enabled = true
listen = "{{ mtg_api_bind }}"
whitelist = ["127.0.0.1/32", "::1/128"]
auth-header = "{{ mtg_api_auth_header }}"
read-only = false

# On failed handshake mtg dials the hostname embedded in the client secret (SNI).
# Use MTG_DEFAULT_HOST = MTG_DOMAIN so fronting hits this server, not a third-party site.

[defense.anti-replay]
enabled = true

[defense.doppelganger]
# Artificial TLS record delays (high Telegram ping). Off for low-latency use.
disabled = true

[defense.blocklist]
enabled = false

[defense.allowlist]
enabled = false
