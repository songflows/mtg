# mtg control API — {{ mtg_domain }}

server {
    listen 80;
    listen [::]:80;
    server_name {{ mtg_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$http_host$request_uri;
    }
}

server {
    listen {{ mtg_api_public_port }} ssl http2;
    listen [::]:{{ mtg_api_public_port }} ssl http2;
    server_name {{ mtg_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ mtg_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ mtg_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 64k;

    location / {
        proxy_pass http://{{ mtg_api_bind }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
