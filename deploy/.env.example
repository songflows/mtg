# Copy to deploy/.env and adjust before: ansible-playbook -i deploy/ansible/inventory.ini deploy/ansible/playbook.yml

MTG_SSH_HOST=93.127.222.152
MTG_SSH_USER=root

MTG_DOMAIN=stun06-ge.zxcv.best
MTG_PUBLIC_IP=93.127.222.152

# MTProto listener (must be free on the host; 443 is used by ocserv)
MTG_PROXY_PORT=3129

# Control API (loopback) + public HTTPS port on nginx
MTG_API_BIND=127.0.0.1:9092
MTG_API_PUBLIC_PORT=8445

# telemt-style Authorization header value (exact match)
MTG_API_AUTH_HEADER="Bearer CHANGE_ME"

# ee-secret for template user / domain fronting (mtg generate-secret <host>)
MTG_SECRET=eeCHANGE_ME

# FakeTLS hostname embedded in auto-generated per-user secrets
MTG_DEFAULT_HOST=stun06-ge.zxcv.best
